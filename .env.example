# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
# Optional: set for instant command registration in one guild during development.
# Leave empty to register commands globally (can take up to 1 hour to propagate).
DISCORD_DEV_GUILD_ID=

# The single voice channel the bot is allowed to operate in.
VOICE_CHANNEL_ID=your-voice-channel-id
# The category that voice channel lives in (used for validation/logging).
CATEGORY_ID=your-category-id

# Comma-separated list of role IDs allowed to control the bot.
# Leave empty to allow any member currently in the configured voice channel.
ALLOWED_ROLE_IDS=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key is required for storage signed URLs + DB writes from the bot.
# Never expose this key client-side. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=discord
SUPABASE_SONGS_TABLE=songs

# ---------------------------------------------------------------------------
# Playback / behavior tuning
# ---------------------------------------------------------------------------
AUTO_JOIN_DELAY_MS=30000
AUTO_LEAVE_DELAY_MS=30000
DEFAULT_VOLUME=0.5
# Per-user, per-command cooldown.
COMMAND_COOLDOWN_MS=3000
# Extra per-guild, per-command ceiling (anti-spam / quota protection).
GUILD_COMMAND_COOLDOWN_MS=1000
SIGNED_URL_EXPIRY_SECONDS=3600
# How often (ms) the bot rescans the Storage bucket for newly uploaded music.
LIBRARY_SYNC_INTERVAL_MS=120000
# Hard caps to bound memory and ffmpeg processes.
MAX_QUEUE_LENGTH=200
MAX_VOICE_CONNECTIONS=5
MAX_FILE_SIZE_BYTES=52428800
# Stop advancing (and count toward a supervisor restart) after this many
# tracks fail in a row. Prevents an infinite refill loop on a broken library.
MAX_CONSECUTIVE_TRACK_FAILURES=5

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# "friendly" (default) prints short, plain-English lines like "Track started".
# Set to "json" for raw structured JSON (useful for log aggregators/dashboards).
LOG_FORMAT=friendly
# Directory for bot.log, restarts.log, and heartbeat.json (created automatically).
LOG_DIR=./logs
HEARTBEAT_PATH=
HEARTBEAT_INTERVAL_MS=15000
METRICS_INTERVAL_MS=120000
NODE_ENV=production
# Render sets PORT automatically if deployed as a Web Service. HEALTH_PORT can
# be used on a VPS. Either one starts GET /health (liveness), GET /ready
# (Discord session), and GET /metrics.
PORT=
HEALTH_PORT=
# Bind address for the health server. Default: 0.0.0.0 when PORT is set (Render),
# otherwise 127.0.0.1. Override with 0.0.0.0 if a remote probe must reach HEALTH_PORT.
HEALTH_BIND=
# If set, GET /metrics requires Authorization: Bearer <token> or X-Health-Token.
# GET /health stays unauthenticated (liveness only).
HEALTH_TOKEN=
