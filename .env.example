# ---- Discord ----
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-server-id
# The voice channel to watch/auto-join (e.g. "music-bot")
MUSIC_VOICE_CHANNEL_ID=your-voice-channel-id
# Text channel where the bot is allowed to respond to /commands (optional, leave blank to allow anywhere)
BOT_TEXT_CHANNEL_ID=

# ---- Backblaze B2 (S3-compatible API) ----
# Use an Application Key scoped to your bucket — NOT the Master Application Key.
# keyID (starts with 005...) → B2_KEY_ID
# applicationKey (shown once at creation) → B2_APPLICATION_KEY
# bucketName from B2 → B2_BUCKET_NAME
# S3 endpoint/region: open your bucket in B2 → "S3 Endpoint" (e.g. us-east-005, NOT always us-west-004)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name
# Optional folder prefix inside the bucket, e.g. "music/". Leave blank if files are at bucket root.
B2_PREFIX=

# ---- Behavior ----
AUTO_JOIN_DELAY_SECONDS=30
DEFAULT_VOLUME=100
# Shuffle the playlist order on load (true/false)
SHUFFLE_PLAYLIST=false
# Prefix for text chat commands (e.g. !play, !skip)
COMMAND_PREFIX=!

# ---- Hosting (Render) ----
# Render sets PORT automatically for Web Services. Only needed if you deploy as a Web Service
# instead of a Background Worker (see README).
PORT=3000
