# ---- Discord ----
DISCORD_TOKEN=c7Q
CLIENT_ID=
GUILD_ID=
# The voice channel to watch/auto-join (e.g. "music-bot")
MUSIC_VOICE_CHANNEL_ID=
# Text channel where the bot is allowed to respond to /commands (optional, leave blank to allow anywhere)
BOT_TEXT_CHANNEL_ID=

# ---- Backblaze B2 (S3-compatible API) ----
# Use the "discordmusicbot" Application Key — NOT the Master Application Key.
# B2 dashboard field "keyID" (starts with 005...) → B2_KEY_ID
# B2 dashboard field "applicationKey" (shown ONCE when key is created) → B2_APPLICATION_KEY
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=DiscordMusics
# Music files are at the bucket root (no subfolder). Leave blank unless you use a folder prefix.
B2_PREFIX=

# ---- Behavior ----
AUTO_JOIN_DELAY_SECONDS=30
DEFAULT_VOLUME=100
# Shuffle the playlist order on load (true/false)
SHUFFLE_PLAYLIST=false

# ---- Hosting (Render) ----
# Render sets PORT automatically for Web Services. Only needed if you deploy as a Web Service
# instead of a Background Worker (see README).
PORT=3000





