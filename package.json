{
  "name": "discord-supabase-music-bot",
  "version": "1.0.0",
  "description": "Production-ready Discord music bot streaming audio directly from Supabase Storage, with per-guild queues, auto-join/auto-leave, and structured logging.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "lint:syntax": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@supabase/supabase-js": "^2.45.4",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prism-media": "^1.3.5"
  }
}
